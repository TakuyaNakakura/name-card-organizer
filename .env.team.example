# Docker: docker compose --env-file .env.team.local ...
# Secrets are server-only. Never prefix credentials with NEXT_PUBLIC_.
BETTER_AUTH_URL=http://localhost:3000
TEAM_AUTH_MODE=password
BETTER_AUTH_SECRET=
# Existing Vercel SESSION_SECRET (32+ random characters) is accepted if BETTER_AUTH_SECRET is unset.
SESSION_SECRET=
# Only required for TEAM_AUTH_MODE=google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
# Operator/bootstrap only. Never put bootstrap credentials on the running Vercel app.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=管理者
BOOTSTRAP_ADMIN_PASSWORD=
TEAM_NAME=共有名刺チーム
CRON_SECRET=

# Host commands use the local PostgreSQL port. Vercel uses a dedicated Neon runtime role.
DATABASE_URL=postgres://postgres:postgres@localhost:55433/name_card_organizer
# Migration/operator machine ONLY. Do not set this on the running Vercel project.
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:55433/name_card_organizer

OCR_PROVIDER=mock
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=var/uploads

# Production: OCR_PROVIDER=google / STORAGE_DRIVER=s3
# Vision service-account JSON must be minified to ONE line (Google OAuth is separate).
GOOGLE_CLOUD_CREDENTIALS_JSON=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
